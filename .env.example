#--------------------------------------------------------------------
# Example Environment Configuration file
#
# This file can be used as a starting point for your own
# custom .env files, and contains most of the possible settings
# available in a default install.
#
# By default, all of the settings are commented out. If you want
# to override the setting, you must un-comment it by removing the '#'
# at the beginning of the line.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development
#CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 

#app.baseURL = 'https://TU-APP.up.railway.app/'


# If you have trouble with `.`, you could also use `_`.
# app_baseURL = ''
# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false

# Zona horaria de la aplicación. Debe ser siempre la de España (maneja CET/CEST automáticamente).
# Por defecto ya es 'Europe/Madrid' en app/Config/App.php; solo descomentar para forzar otra.
# app.appTimezone = 'Europe/Madrid'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = db
database.default.database = 1
database.default.username = 1
database.default.password = 1
database.default.DBDriver = 1
database.default.port = 3306
# database.default.DBPrefix =


#--------------------------------------------------------------------
# DATABASE RAILWAY
#--------------------------------------------------------------------
#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# encryption.key =

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = null

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

# logger.threshold = 4

#--------------------------------------------------------------------
# MAIL (Resend API)
# ⚠️  Nunca subir este archivo a git con claves reales
#--------------------------------------------------------------------

# API key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Remitente. El dominio debe estar verificado en Resend.
# El de pruebas "onboarding@resend.dev" solo entrega al dueño de la cuenta.
MAIL_FROM="JP Preparation <noreply@jppreparation.com>"
